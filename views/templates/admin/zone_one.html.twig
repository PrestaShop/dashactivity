<div class="mb-3">
  {% component 'Card' with {title: kpiTitle, icon: 'insights', configUrl: configUrl} %}
    {% block content %}
      <ul class="list-group">
        {% for item in kpiItems %}
          <li class="list-group-item d-flex justify-content-between align-items-center">
            {{ item.label }}
            <span class="badge badge-primary badge-pill">{{ item.value }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endblock %}
  {% endcomponent %}
</div>

{{ component('ChartCard', {
  chartId: chartId,
  config: chartConfig,
  height: 280,
  title: chartTitle,
  icon: 'donut_small',
}) }}
