{% import '@PrestaShop/Admin/Dashboard/_partials/card_header.html.twig' as dashboard %}

<div class="card mb-3">
  {{ dashboard.renderCardHeader(kpiTitle, 'insights', configUrl) }}
  <div class="card-body">
    <ul class="list-group">
      {% for item in kpiItems %}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          {{ item.label }}
          <span class="badge badge-primary badge-pill">{{ item.value }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3 class="card-header-title"><i class="material-icons">donut_small</i> {{ chartTitle }}</h3>
  </div>
  <div class="card-body">
    <canvas id="{{ chartId }}" data-chart height="180" role="img" aria-label="{{ chartTitle }}"></canvas>
    <script type="application/json" id="{{ chartId }}-data">{{ chartConfig|raw }}</script>
  </div>
</div>
